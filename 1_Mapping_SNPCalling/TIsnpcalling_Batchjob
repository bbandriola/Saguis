#!/bin/bash

################-> are comments
################-> "#SBATCH" (only one "#") are Batch Script commands

################ Verbose mode

#SBATCH --export=ALL

################

################ Change these parameters according to your requisites

## nodes
#SBATCH -N 1
## or
## tasks (threads)
##SBATCH -n 10

## time
##SBATCH -t 96:00:00
## time formats =  "minutes", "minutes:seconds", "hours:minutes:seconds", "days-hours", "days-hours:minutes" and "days-hours:minutes:seconds"

## --exclusive alloc all threads from each node. If not set, it will alloc only threads set by "-n" parameter
#SBATCH --exclusive

################ Please, change this e-mail address to yours

#SBATCH --mail-type=ALL
#SBATCH --mail-user=bruna.andriola@edu.pucrs.br

################

#SBATCH --no-requeue

################ Output options


## %%     The character "%".
## %A     Job array's master job allocation number.
## %a     Job array ID (index) number.
## %J     jobid.stepid of the running job. (e.g. "128.0")
## %j     jobid of the running job.
## %N     short hostname. This will create a separate IO file per node.
## %n     Node identifier relative to current job (e.g. "0" is the first node of the running job) This will create  a  separate IO file per node.
## %s     stepid of the running job.
## %t     task identifier (rank) relative to current job. This will create a separate IO file per task.
## %u     User name.
## %x     Job name.

## different files for normal output end error output
##SBATCH -o %x.%j.out -e %x.%j.err
## or
## all output in same file
#SBATCH -o %x.%j.out

################

################ Please, change this directory to your working dir.

#SBATCH -D ./

################

################
echo Running on host `hostname`
echo
echo Initial Time is `date`
echo
echo Directory is `pwd`
echo
echo This jobs runs on the following nodes:
echo $SLURM_JOB_NODELIST
echo
echo JOB_ID:
echo $SLURM_JOBID
echo ################

############# Command example, if using MPI

###### FIRST part
source /home/bruna.andriola/script.sh
conda activate bcftools
bcftools mpileup -b TIbamlist_saguis -C50 -f /labgenomaarea2/saguis-lucero/1_Mapping_SNPCalling/RefGenome/GCF_049354715.1_calJac240_pri/GCF_049354715.1_calJac240_pri_genomic.fasta -d100 -Q30 -q30 --threads 48 -a FORMAT/AD,FORMAT/DP,INFO/AD -I | bcftools call -o TI_RawQq30d100_refcalJac.vcf.gz -Oz -c -f GQ -v --threads 48
bcftools norm -f /labgenomaarea2/saguis-lucero/1_Mapping_SNPCalling/RefGenome/GCF_049354715.1_calJac240_pri/GCF_049354715.1_calJac240_pri_genomic.fasta -Oz -o TI_NormRawQq30d100_refcalJac.vcf.gz TI_RawQq30d100_refcalJac.vcf.gz
############################
###### FILTERING PART ######
############################
### Include only Autosomes
conda activate bcftools
bcftools index --threads 48 TI_NormRawQq30d100_refcalJac.vcf.gz
bcftools view -R Autchr.txt --threads 48 -Oz -o TI_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf.gz TI_NormRawQq30d100_refcalJac.vcf.gz
### FILTERINF FOR: min and maxDP, quality and bialelic only
conda activate bcftools
bcftools filter -S . -e 'FMT/DP<10 || FMT/DP>40' --threads 48 TI_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf.gz -Ou | bcftools view --include 'F_MISSING = 0.0 && QUAL > 30' --types snps -m2 -M2 --threads 48 -Oz -o TI_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf.gz
bcftools filter -S . -e 'FMT/DP<10 || FMT/DP>40' --threads 48 TI_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf.gz -Ou | bcftools view --include 'F_MISSING < 0.3 && QUAL > 30' --types snps -m2 -M2 --threads 48 -Oz -o TI_Missing30OnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf.gz
### FILTERINF FOR: hwe, maf
conda activate vcftools
vcftools --gzvcf TI_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf.gz --hwe 0.001 --maf 0.05 --recode --recode-INFO-all --out TI_hwe0.001maf0.05_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac  
vcftools --gzvcf TI_Missing30OnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf.gz --hwe 0.001 --maf 0.05 --recode --recode-INFO-all --out TI_hwe0.001maf0.05_Missing30OnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac  
vcftools --gzvcf TI_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf.gz --hwe 0.001 --maf 0.1 --recode --recode-INFO-all --out TI_hwe0.001maf0.1_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac
gzip TI_hwe0.001maf0.05_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf
gzip TI_hwe0.001maf0.05_Missing30OnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf
gzip TI_hwe0.001maf0.1_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf
###### FILTERINF FOR: LD
vcftools --gzvcf TI_hwe0.001maf0.05_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf.gz --thin 10000 --recode --recode-INFO-all --out TI_1SNPevery10kb_hwe0.001maf0.05_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac
vcftools --gzvcf TI_hwe0.001maf0.05_Missing30OnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf.gz --thin 10000 --recode --recode-INFO-all --out TI_1SNPevery10kb_hwe0.001maf0.05_Missing30OnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac
vcftools --gzvcf TI_hwe0.001maf0.1_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf.gz --thin 10000 --recode --recode-INFO-all --out TI_1SNPevery10kb_hwe0.001maf0.1_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac
gzip TI_1SNPevery10kb_hwe0.001maf0.05_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf
gzip TI_1SNPevery10kb_hwe0.001maf0.05_Missing30OnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf
gzip TI_1SNPevery10kb_hwe0.001maf0.1_NoMissingOnlyBialelicsQuali30_minDP10maxDP40_OnlyAut_NormRawQq30d100_refcalJac.recode.vcf

################

#./application

################

echo Final Time is `date`
